<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/piq_background"
    android:paddingHorizontal="32dp"
    android:paddingTop="80dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create your account"
        android:textColor="@color/piq_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username"
        android:inputType="textNoSuggestions"
        android:maxLength="20"
        android:textColorHint="@color/piq_text_hint"
        android:textColor="@color/piq_text_primary"
        android:background="@color/piq_surface"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/piq_text_hint"
        android:textColor="@color/piq_text_primary"
        android:background="@color/piq_surface"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password (min 6 characters)"
        android:inputType="textPassword"
        android:textColorHint="@color/piq_text_hint"
        android:textColor="@color/piq_text_primary"
        android:background="@color/piq_surface"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/confirmPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm password"
        android:inputType="textPassword"
        android:textColorHint="@color/piq_text_hint"
        android:textColor="@color/piq_text_primary"
        android:background="@color/piq_surface"
        android:padding="14dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/piq_error"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/registerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textColor="@color/piq_on_accent"
        android:backgroundTint="@color/piq_accent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/goToSignInText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Already have an account? Sign in"
        android:textColor="@color/piq_accent_text"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
