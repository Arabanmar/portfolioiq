<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/portfolioiq_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Portfolio"
            android:textColor="@color/portfolioiq_cream"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/totalValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="$0.00"
            android:textColor="@color/portfolioiq_cream"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/totalProfitLossText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No holdings yet"
            android:textColor="@color/portfolioiq_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/portfolioiq_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/addHoldingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="+ Add Holding"
            android:textColor="@color/portfolioiq_navy"
            android:backgroundTint="@color/portfolioiq_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Holdings"
            android:textColor="@color/portfolioiq_cream"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/holdingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You haven't added any stocks yet."
            android:textColor="@color/portfolioiq_muted"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
