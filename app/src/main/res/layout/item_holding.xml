<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/portfolioiq_navy_light"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tickerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AAPL"
            android:textColor="@color/portfolioiq_cream"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/positionValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/portfolioiq_cream"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 shares @ $0.00"
            android:textColor="@color/portfolioiq_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/profitLossText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+$0.00 (0.0%)"
            android:textColor="@color/portfolioiq_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/allocationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="0.0% of portfolio"
            android:textColor="@color/portfolioiq_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/editHoldingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Edit"
            android:textColor="@color/portfolioiq_gold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/deleteHoldingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@color/portfolioiq_error"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
