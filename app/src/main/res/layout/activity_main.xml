<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/portfolioiq_navy"
    android:paddingHorizontal="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PortfolioIQ"
        android:textColor="@color/portfolioiq_cream"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Understand your portfolio, in plain language"
        android:textColor="@color/portfolioiq_muted"
        android:textSize="15sp"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/signInButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:textColor="@color/portfolioiq_navy"
        android:backgroundTint="@color/portfolioiq_gold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/createAccountButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textColor="@color/portfolioiq_cream"
        android:backgroundTint="@color/portfolioiq_navy_light" />

</LinearLayout>
