# PortfolioIQ AI server settings.
# setup_server.bat copies this file to ".env". Edit .env, never this file:
# .env holds your real key and is gitignored, so it never reaches GitHub.

# Your Gemini API key from aistudio.google.com (Get API key > Create API key).
GOOGLE_API_KEY=

# Gemini models. Change them if your key can't use these ones.
# The quick model makes most of the calls; the deep model writes the final decisions.
PIQ_QUICK_MODEL=gemini-3.5-flash-lite
PIQ_DEEP_MODEL=gemini-3.8-flash

# TradingAgents analysts run for each stock: market, social, news, fundamentals.
PIQ_ANALYSTS=market,news,fundamentals

# 1 = fake answers instantly, without Gemini (to test the app screens quickly).
PIQ_FAKE_AI=0

# Optional shared secret. If you set it, put the same value in the app's
# local.properties as AI_SERVER_TOKEN=...
PIQ_SERVER_TOKEN=
